<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:url var="patientSignupUrl" value="/register/patient"><c:if test="${not empty param.next}"><c:param name="next" value="${param.next}"/></c:if></c:url>
<c:set var="pageTitle" value="Sign in"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="auth-layout">
  <div class="auth-aside"><div class="eyebrow eyebrow-light">ROLE-BASED ACCESS</div><h1>Welcome back.</h1><p>Sign in through the portal that matches your Online Medic account.</p><div class="auth-quote">Your account role determines the workspace you can access.</div></div>
  <div class="auth-panel"><span class="eyebrow"><c:out value="${loginRole}"/> PORTAL</span><h2><c:out value="${loginRole}"/> sign in</h2><p class="muted">Use the email and password registered for this role.</p>
    <c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if>
    <form method="post" action="${loginPath}" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="next" value="<c:out value='${param.next}'/>"><label>Email address<input type="email" name="email" autocomplete="username" required maxlength="190" value="<c:out value='${param.email}'/>" placeholder="you@example.com"></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="128" placeholder="Your password"></label><button class="button button-full" type="submit">Sign in as <c:out value="${loginRole}"/> <span>→</span></button></form>
    <p class="auth-switch"><a href="${pageContext.request.contextPath}/login">Use the general sign-in page</a></p>
    <p class="auth-switch"><c:choose><c:when test="${loginRole eq 'PATIENT'}">New patient? <a href="${patientSignupUrl}">Create a patient account</a></c:when><c:when test="${loginRole eq 'DOCTOR'}">Doctor accounts are created by an administrator. <a href="${pageContext.request.contextPath}/register/doctor">About doctor signup</a></c:when><c:when test="${loginRole eq 'PHARMACIST'}">Pharmacist accounts are created by an administrator. <a href="${pageContext.request.contextPath}/register/pharmacist">About pharmacist signup</a></c:when><c:when test="${loginRole eq 'ADMIN'}">First admin setup? <a href="${pageContext.request.contextPath}/register/admin">Admin account setup</a></c:when><c:otherwise>Delivery accounts are created by an administrator.</c:otherwise></c:choose></p>
  </div>
</section>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
