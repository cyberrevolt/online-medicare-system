<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Your profile"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>

<section class="page-intro"><div><div class="eyebrow">PATIENT ACCOUNT</div><h1>Your profile</h1><p>Keep your contact details and delivery addresses current.</p></div><a class="button button-outline" href="${pageContext.request.contextPath}/dashboard">Dashboard</a></section>
<div class="profile-layout">
  <section class="panel-card"><span class="eyebrow">PERSONAL DETAILS</span><h2>Profile information</h2><form method="post" action="${pageContext.request.contextPath}/patient/profile" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="saveProfile">
    <label>Full name<input name="name" value="<c:out value='${profileName}'/>" required minlength="2" maxlength="120" autocomplete="name"></label><label>Email<input value="<c:out value='${profileEmail}'/>" readonly autocomplete="email"><span class="optional">Contact support to change your sign-in email.</span></label><label>Phone<input type="tel" name="phone" value="<c:out value='${profilePhone}'/>" maxlength="30" autocomplete="tel"></label>
    <div class="form-row"><label>Date of birth<input type="date" name="dateOfBirth" max="${today}" value="<c:out value='${profileDateOfBirth}'/>"></label><label>Gender<select name="gender"><option value="">Prefer not to say</option><option <c:if test="${profileGender eq 'Female'}">selected</c:if>>Female</option><option <c:if test="${profileGender eq 'Male'}">selected</c:if>>Male</option><option <c:if test="${profileGender eq 'Non-binary'}">selected</c:if>>Non-binary</option><option <c:if test="${profileGender eq 'Prefer not to say'}">selected</c:if>>Prefer not to say</option></select></label></div>
    <label>Emergency contact <span class="optional">Optional · name and phone</span><input name="emergencyContact" value="<c:out value='${emergencyContact}'/>" maxlength="100" placeholder="Contact name · phone number"></label><button class="button" type="submit">Save profile</button>
  </form></section>

  <section class="panel-card"><span class="eyebrow">DELIVERY ADDRESSES</span><h2>Saved addresses</h2><p class="muted">Addresses attached to past orders stay unchanged for order history. Add a new address for future deliveries when needed.</p>
    <c:choose><c:when test="${not empty addresses}"><div class="saved-address-list"><c:forEach var="address" items="${addresses}"><details class="saved-address"><summary><strong><c:out value="${address.label}"/></strong><c:if test="${address.isDefault}"><span class="pill pill-green">Default</span></c:if><span><c:out value="${address.city}"/>, <c:out value="${address.state}"/> · <c:out value="${address.postalCode}"/></span></summary>
      <form method="post" action="${pageContext.request.contextPath}/patient/profile" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="saveAddress"><input type="hidden" name="addressId" value="${address.id}">
        <div class="form-row"><label>Label<input name="label" value="<c:out value='${address.label}'/>" required minlength="2" maxlength="60"></label><label>Six-digit PIN code<input name="postalCode" value="<c:out value='${address.postalCode}'/>" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required></label></div>
        <label>House / street address<input name="line1" value="<c:out value='${address.line1}'/>" required minlength="5" maxlength="220"></label>
        <div class="form-row"><label>City / post office<input name="city" value="<c:out value='${address.city}'/>" required minlength="2" maxlength="100"></label><label>District<input name="district" value="<c:out value='${address.district}'/>" required minlength="2" maxlength="100"></label></div>
        <label>State / union territory<select name="state" required><c:forEach var="state" items="${states}"><option value="<c:out value='${state}'/>" <c:if test="${address.state eq state}">selected</c:if>><c:out value="${state}"/></option></c:forEach></select></label>
        <label class="checkbox-line"><input type="checkbox" name="isDefault" value="true" <c:if test="${address.isDefault}">checked</c:if>> Use as my default delivery address</label>
        <div class="profile-actions"><button class="button button-small" type="submit">Save address</button></div>
      </form><div class="profile-actions"><c:if test="${not address.isDefault}"><form method="post" action="${pageContext.request.contextPath}/patient/profile"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="makeDefault"><input type="hidden" name="addressId" value="${address.id}"><button class="button button-small button-outline" type="submit">Make default</button></form></c:if><form method="post" action="${pageContext.request.contextPath}/patient/profile" data-confirm="Remove this saved address?"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="deleteAddress"><input type="hidden" name="addressId" value="${address.id}"><button class="text-link danger-link" type="submit">Remove address</button></form></div>
    </details></c:forEach></div></c:when><c:otherwise><p class="muted">You have no saved delivery addresses yet.</p></c:otherwise></c:choose>
    <details class="add-address"><summary>Add a delivery address</summary><form method="post" action="${pageContext.request.contextPath}/patient/profile" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="saveAddress"><div class="form-row"><label>Label<input name="label" value="Home" required minlength="2" maxlength="60" placeholder="Home, Work"></label><label>Six-digit PIN code<input name="postalCode" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required></label></div><label>House / street address<input name="line1" required minlength="5" maxlength="220"></label><div class="form-row"><label>City / post office<input name="city" required minlength="2" maxlength="100"></label><label>District<input name="district" required minlength="2" maxlength="100"></label></div><label>State / union territory<select name="state" required><option value="">Choose a state</option><c:forEach var="state" items="${states}"><option value="<c:out value='${state}'/>"><c:out value="${state}"/></option></c:forEach></select></label><label class="checkbox-line"><input type="checkbox" name="isDefault" value="true"> Use as my default delivery address</label><button class="button" type="submit">Save new address</button></form></details>
  </section>
</div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
