<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:url var="patientLoginUrl" value="/login/patient"><c:if test="${not empty param.next}"><c:param name="next" value="${param.next}"/></c:if></c:url><c:set var="pageTitle" value="Create account"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="auth-layout"><div class="auth-aside"><div class="eyebrow eyebrow-light">A MORE CONNECTED WAY TO CARE</div><h1>Take the next step in your health journey.</h1><p>Create a patient account to book care and manage your pharmacy orders.</p><div class="auth-quote">Your information stays within the account you create for this demonstration.</div></div><div class="auth-panel"><span class="eyebrow">PATIENT ACCOUNT</span><h2>Create your account</h2><p class="muted">All fields marked required are needed to register.</p><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="next" value="<c:out value='${param.next}'/>"><label>Full name<input name="name" required minlength="2" maxlength="120" autocomplete="name" value="<c:out value='${param.name}'/>" placeholder="Your name"></label><label>Email address<input type="email" name="email" required maxlength="190" autocomplete="email" value="<c:out value='${param.email}'/>" placeholder="you@example.com"></label><label>Phone <span class="optional">(optional)</span><input name="phone" maxlength="30" autocomplete="tel" value="<c:out value='${param.phone}'/>" placeholder="+91 98765 43210"></label><label>Password <span class="optional">(10+ characters, with a letter and number)</span><input type="password" name="password" required minlength="10" maxlength="128" autocomplete="new-password"></label><button class="button button-full" type="submit">Create patient account <span>→</span></button></form><p class="auth-switch">Already have an account? <a href="${patientLoginUrl}">Sign in</a></p></div></section>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
