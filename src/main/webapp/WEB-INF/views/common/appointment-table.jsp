<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:choose><c:when test="${not empty appointments}"><div class="table-scroll"><table><thead><tr><th>Patient / Doctor</th><th>Date and time</th><th>Type</th><th>Status</th><th>Next step</th></tr></thead><tbody><c:forEach var="a" items="${appointments}" end="5"><tr><td><strong><c:out value="${a.doctorName}"/></strong></td><td><c:out value="${a.date}"/> · <c:out value="${a.time}"/></td><td><c:out value="${a.type}"/></td><td><span class="pill"><c:out value="${a.status}"/></span></td><td><c:choose><c:when test="${a.status eq 'CONFIRMED' and (sessionScope.user.role eq 'PATIENT' or sessionScope.user.role eq 'DOCTOR')}"><a class="text-link" href="${pageContext.request.contextPath}/consultation?id=${a.id}">Open appointment room →</a></c:when><c:when test="${a.status eq 'COMPLETED' and sessionScope.user.role eq 'PATIENT'}"><a class="text-link" href="${pageContext.request.contextPath}/doctors">Book a new appointment →</a></c:when><c:when test="${a.status eq 'COMPLETED' and sessionScope.user.role eq 'DOCTOR'}"><a class="text-link" href="${pageContext.request.contextPath}/consultation?id=${a.id}">Review completed visit →</a></c:when><c:when test="${sessionScope.user.role eq 'PATIENT' and a.status eq 'PENDING' and a.paymentStatus eq 'PENDING'}"><a class="text-link" href="${pageContext.request.contextPath}/payment?appointment=${a.id}">Continue demo payment →</a></c:when><c:otherwise><span class="muted tiny">No action needed</span></c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><p class="muted">No appointments have been booked yet.</p></c:otherwise></c:choose>
