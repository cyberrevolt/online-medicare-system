<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Administration"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="dashboard-welcome"><div><div class="eyebrow">ADMIN CONSOLE</div><h1>System overview</h1><p>Live counts and operational queues from this database.</p></div><div class="admin-shortcuts"><a class="button button-soft" href="${pageContext.request.contextPath}/admin/orders">Order queue →</a><a class="button button-outline" href="#admin-reports">Reports →</a><a class="button button-outline" href="#refund-management">Refunds →</a><a class="button button-outline" href="#doctor-management">Manage doctors →</a><a class="button button-outline" href="${pageContext.request.contextPath}/admin/doctors">Add a doctor →</a><a class="button button-outline" href="${pageContext.request.contextPath}/admin/staff">Manage staff →</a><a class="button button-outline" href="${pageContext.request.contextPath}/prescriptions">Prescription review →</a></div></section>
<div class="stats-grid"><div class="stat-card"><span>Patients</span><strong><c:out value="${stats.patients}"/></strong><small>registered accounts</small></div><div class="stat-card"><span>Doctors</span><strong><c:out value="${stats.doctors}"/></strong><small>professionals</small></div><div class="stat-card"><span>Pharmacists</span><strong><c:out value="${stats.pharmacists}"/></strong><small>team members</small></div><div class="stat-card"><span>Delivery staff</span><strong><c:out value="${stats.delivery}"/></strong><small>team members</small></div><div class="stat-card"><span>Medicines</span><strong><c:out value="${stats.medicines}"/></strong><small>catalogue</small></div><div class="stat-card"><span>Orders</span><strong><c:out value="${stats.orders}"/></strong><small><c:out value="${stats.pending}"/> in progress</small></div><div class="stat-card"><span>Refunds needing action</span><strong><c:out value="${stats.refundsPending}"/></strong><small>pending review or processing</small></div><div class="stat-card"><span>Appointments</span><strong><c:out value="${stats.appointments}"/></strong><small>all time</small></div><div class="stat-card"><span>Successful demo payments</span><strong>₹<c:out value="${stats.revenue}"/></strong><small>simulated transactions only</small></div></div>
<section class="panel-card admin-report-panel" id="admin-reports"><div class="results-heading"><div><span class="eyebrow">OPERATIONS REPORT</span><h2>Last 30 days</h2><p class="muted"><c:out value="${report.from}"/> through <c:out value="${report.to}"/> · demo payment records only</p></div></div><div class="stats-grid report-stats"><div class="stat-card"><span>Orders placed</span><strong><c:out value="${report.orders}"/></strong><small>includes cancelled orders</small></div><div class="stat-card"><span>Successful pharmacy payments</span><strong>₹<c:out value="${report.orderRevenue}"/></strong><small>simulated only</small></div><div class="stat-card"><span>Appointments booked</span><strong><c:out value="${report.appointments}"/></strong><small>in this period</small></div><div class="stat-card"><span>Consultation payments</span><strong>₹<c:out value="${report.appointmentRevenue}"/></strong><small>successful demo records</small></div><div class="stat-card"><span>Medicine units sold</span><strong><c:out value="${report.unitsSold}"/></strong><small>cancelled and returned orders excluded</small></div><div class="stat-card"><span>Open return requests</span><strong><c:out value="${report.openReturns}"/></strong><small>awaiting pharmacy review</small></div></div><h3>Top medicines by units sold</h3><c:choose><c:when test="${not empty report.topMedicines}"><div class="table-scroll"><table><thead><tr><th>Medicine</th><th>Units</th><th>Gross line total</th></tr></thead><tbody><c:forEach var="item" items="${report.topMedicines}"><tr><td><strong><c:out value="${item.name}"/></strong></td><td><c:out value="${item.units}"/></td><td>₹<c:out value="${item.gross}"/></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><p class="muted">No medicine orders were placed in this period.</p></c:otherwise></c:choose></section>
<section class="panel-card admin-doctors-panel" id="doctor-management"><div class="results-heading"><div><span class="eyebrow">DOCTOR DIRECTORY</span><h2>Manage doctor profiles</h2><p class="muted">View account details, edit profile information, change sign-in email, reset a password, or pause an account.</p></div><span class="pill"><c:out value="${adminDoctors.size()}"/> profiles</span></div><c:choose><c:when test="${not empty adminDoctors}"><div class="admin-doctor-list"><c:forEach var="doctor" items="${adminDoctors}"><article class="admin-doctor-card"><div class="admin-doctor-summary"><c:choose><c:when test="${not empty doctor.profileImage}"><img class="admin-doctor-photo" src="${pageContext.request.contextPath}${doctor.profileImage}" alt="Doctor profile"></c:when><c:otherwise><div class="admin-doctor-avatar">MD</div></c:otherwise></c:choose><div class="admin-doctor-heading"><div><h3><c:out value="${doctor.name}"/></h3><span class="specialty"><c:out value="${doctor.specialization}"/></span><span class="admin-doctor-sub"><c:out value="${doctor.email}"/><c:if test="${not empty doctor.phone}"> · <c:out value="${doctor.phone}"/></c:if></span></div><div class="admin-doctor-badges"><c:if test="${doctor.demoProfile}"><span class="pill pill-demo">Fictional demo</span></c:if><c:choose><c:when test="${doctor.active}"><span class="pill pill-green">Active</span></c:when><c:otherwise><span class="pill">Paused</span></c:otherwise></c:choose></div></div></div><div class="admin-doctor-details"><div><small>Qualification</small><strong><c:out value="${doctor.qualification}"/></strong></div><div><small>Registration</small><strong><c:choose><c:when test="${not empty doctor.registration}"><c:out value="${doctor.registration}"/></c:when><c:otherwise>Not entered</c:otherwise></c:choose></strong></div><div><small>Experience</small><strong><c:out value="${doctor.experience}"/> years</strong></div><div><small>Consultation fee</small><strong>₹<c:out value="${doctor.fee}"/></strong></div><div><small>Clinic</small><strong><c:choose><c:when test="${not empty doctor.clinic}"><c:out value="${doctor.clinic}"/></c:when><c:otherwise>Not entered</c:otherwise></c:choose></strong></div><div><small>Rating</small><strong>★ <c:out value="${doctor.rating}"/></strong></div></div><details class="admin-doctor-edit"><summary>Edit doctor profile and access</summary><form method="post" action="${pageContext.request.contextPath}/admin/doctors" class="form-stack" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="doctorId" value="${doctor.id}"><div class="form-row"><label>Full name<input name="name" required minlength="2" maxlength="120" value="<c:out value='${doctor.name}'/>" autocomplete="name"></label><label>Sign-in email<input type="email" name="email" required maxlength="190" value="<c:out value='${doctor.email}'/>" autocomplete="email"></label></div><div class="form-row"><label>Phone<input name="phone" maxlength="30" value="<c:out value='${doctor.phone}'/>"></label><label>Specialization<input name="specialization" required maxlength="100" value="<c:out value='${doctor.specialization}'/>"></label></div><div class="form-row"><label>Qualification<input name="qualification" required maxlength="160" value="<c:out value='${doctor.qualification}'/>"></label><label>Medical registration number<input name="registration" maxlength="80" value="<c:out value='${doctor.registration}'/>"></label></div><div class="form-row"><label>Experience (years)<input type="number" name="experience" min="0" max="70" required value="<c:out value='${doctor.experience}'/>"></label><label>Consultation fee (₹)<input type="number" name="fee" min="0" max="100000" step="0.01" required value="<c:out value='${doctor.fee}'/>"></label></div><label>Clinic name<input name="clinic" maxlength="180" value="<c:out value='${doctor.clinic}'/>"></label><label>About<textarea name="about" rows="3" maxlength="1200"><c:out value="${doctor.about}"/></textarea></label><label>Replace profile photo <span class="optional">Optional · JPEG or PNG, max 5 MB</span><input type="file" name="profileImage" accept="image/jpeg,image/png"></label><label>Set a new password <span class="optional">Optional · leave blank to keep the current password</span><input type="password" name="newPassword" minlength="10" maxlength="128" autocomplete="new-password"></label><label class="checkbox-line"><input type="checkbox" name="active" value="true" <c:if test="${doctor.active}">checked</c:if>> Active account (can sign in and appear in the doctor directory)</label><button class="button button-small" type="submit">Save doctor changes</button></form></details></article></c:forEach></div></c:when><c:otherwise><div class="empty-inline">No doctor profiles are in the system yet. Use “Add a doctor” above to create the first profile.</div></c:otherwise></c:choose></section>
<section class="panel-card stock-panel"><div class="results-heading"><div><span class="eyebrow">EXPIRY WATCH</span><h2>Expired and soon-to-expire stock</h2><p class="muted">Expired quantities are excluded from patient-facing stock counts and checkout.</p></div><span class="pill"><c:out value="${stats.expiredBatches}"/> expired · <c:out value="${stats.expiringBatches}"/> expiring</span></div><c:choose><c:when test="${not empty expiryWatch}"><div class="table-scroll"><table><thead><tr><th>Medicine / batch</th><th>Expiry</th><th>Units on hand</th><th>Status</th></tr></thead><tbody><c:forEach var="batch" items="${expiryWatch}"><tr><td><strong><c:out value="${batch.medicineName}"/></strong><span class="table-sub">Batch <c:out value="${batch.batchNumber}"/></span></td><td><c:out value="${batch.expiryDate}"/></td><td><c:out value="${batch.quantity}"/></td><td><span class="pill"><c:choose><c:when test="${batch.expired}">Expired — quarantine</c:when><c:otherwise>Expiring soon</c:otherwise></c:choose></span></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><div class="empty-inline">No expired or soon-to-expire batches are on hand.</div></c:otherwise></c:choose></section>
<section class="panel-card stock-panel"><div class="results-heading"><div><span class="eyebrow">INVENTORY WATCH</span><h2>Low stock medicines</h2></div><span class="pill pill-rx"><c:out value="${stats.lowStock}"/> need review</span></div><c:choose><c:when test="${not empty lowStock}"><div class="table-scroll"><table><thead><tr><th>Medicine</th><th>Category</th><th>Available</th><th>Adjustment</th></tr></thead><tbody><c:forEach var="item" items="${lowStock}"><tr><td><strong><c:out value="${item.name}"/></strong></td><td><c:out value="${item.category}"/></td><td><c:out value="${item.stock}"/></td><td><form method="post" action="${pageContext.request.contextPath}/admin" class="restock-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="restock"><input type="hidden" name="medicineId" value="${item.id}"><label class="sr-only">Add stock quantity</label><input type="number" name="quantity" min="1" max="5000" placeholder="Add units" required><button class="button button-small" type="submit">Restock</button></form></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><div class="empty-inline">No medicines are below their minimum stock threshold.</div></c:otherwise></c:choose></section>
<section class="panel-card"><span class="eyebrow">CATALOGUE ADMIN</span><h2>Add a medicine</h2><p class="muted">New products are added to the public catalogue and inventory transaction history.</p><form method="post" action="${pageContext.request.contextPath}/admin" class="form-stack" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="createMedicine"><div class="form-row"><label>Medicine name<input name="name" required minlength="3" maxlength="180"></label><label>Price (₹)<input type="number" name="price" required min="0" step="0.01"></label></div><div class="form-row"><label>Category<select name="category" required><c:forEach var="item" items="${categories}"><option value="<c:out value='${item}'/>"><c:out value="${item}"/></option></c:forEach></select></label><label>Manufacturer<select name="manufacturer" required><c:forEach var="item" items="${manufacturers}"><option value="<c:out value='${item}'/>"><c:out value="${item}"/></option></c:forEach></select></label></div><label>Description<textarea name="description" rows="2" maxlength="1200"></textarea></label><label>Medicine image (optional, JPEG or PNG, max 5 MB)<input type="file" name="image" accept="image/jpeg,image/png"></label><div class="form-row"><label>Starting stock<input type="number" name="stock" required min="0" max="100000" value="0"></label><label>Low-stock threshold<input type="number" name="minStock" required min="0" max="100000" value="5"></label></div><label class="checkbox-line"><input type="checkbox" name="prescriptionRequired" value="true"> Prescription required for purchase</label><button class="button" type="submit">Add medicine</button></form></section>
<section class="panel-card"><div class="results-heading"><div><span class="eyebrow">OPEN WORK</span><h2>Orders requiring action</h2></div><a class="text-link" href="${pageContext.request.contextPath}/admin/orders">Manage orders →</a></div><c:choose><c:when test="${not empty orderQueue}"><div class="table-scroll"><table><thead><tr><th>Order</th><th>Patient</th><th>Address</th><th>Total</th><th>Status</th></tr></thead><tbody><c:forEach var="o" items="${orderQueue}"><tr><td>#<c:out value="${o.id}"/></td><td><c:out value="${o.patient}"/></td><td><c:out value="${o.address}"/>, <c:out value="${o.city}"/></td><td>₹<c:out value="${o.total}"/></td><td><span class="pill"><c:out value="${o.status}"/></span></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><p class="muted">No open orders.</p></c:otherwise></c:choose></section>
<section class="panel-card" id="refund-management"><div class="results-heading"><div><span class="eyebrow">PAYMENT OPERATIONS</span><h2>Order refund requests</h2><p class="muted">Review patient and pharmacy requests, then record the demo refund workflow.</p></div><span class="pill"><c:out value="${stats.refundsPending}"/> need action</span></div><div class="alert alert-info">Payments in this project are simulated. Marking a refund as processed updates the demo records only; it does not send money to a bank or payment provider.</div><c:choose><c:when test="${not empty refundQueue}"><div class="table-scroll"><table><thead><tr><th>Order / patient</th><th>Request</th><th>Amount</th><th>Status</th><th>Admin action</th></tr></thead><tbody><c:forEach var="refund" items="${refundQueue}"><tr><td><strong>Order #<c:out value="${refund.orderId}"/></strong><span class="table-sub"><c:out value="${refund.patient}"/> · <c:out value="${refund.patientEmail}"/></span><span class="table-sub"><c:out value="${refund.method}"/> · <c:out value="${refund.transactionId}"/></span></td><td><c:out value="${refund.reason}"/><span class="table-sub">Started by <c:out value="${refund.initiatedBy}"/> (<c:out value="${refund.initiatedByRole}"/>) · <c:out value="${refund.createdAt}"/></span></td><td>₹<c:out value="${refund.amount}"/></td><td><span class="pill"><c:out value="${refund.status}"/></span><c:if test="${not empty refund.reviewNote}"><span class="table-sub"><c:out value="${refund.reviewNote}"/></span></c:if></td><td><c:choose><c:when test="${refund.status eq 'PENDING'}"><div class="refund-admin-actions"><form method="post" action="${pageContext.request.contextPath}/admin" class="inline-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="approveRefund"><input type="hidden" name="refundId" value="${refund.id}"><button class="button button-small" type="submit">Approve</button></form><form method="post" action="${pageContext.request.contextPath}/admin" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="rejectRefund"><input type="hidden" name="refundId" value="${refund.id}"><label>Reason for rejection<textarea name="note" rows="2" maxlength="500" required></textarea></label><button class="button button-small button-danger" type="submit">Reject request</button></form></div></c:when><c:when test="${refund.status eq 'APPROVED'}"><form method="post" action="${pageContext.request.contextPath}/admin" class="form-stack" data-confirm="Mark this demo refund as processed? This does not transfer money."><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="processRefund"><input type="hidden" name="refundId" value="${refund.id}"><label>Processing note <span class="optional">Optional</span><textarea name="note" rows="2" maxlength="500" placeholder="Recorded in demo"></textarea></label><button class="button button-small" type="submit">Mark processed</button></form></c:when><c:otherwise><span class="muted"><c:choose><c:when test="${refund.status eq 'PROCESSED'}">Recorded <c:out value="${refund.processedAt}"/></c:when><c:otherwise>Reviewed <c:out value="${refund.reviewedAt}"/></c:otherwise></c:choose></span></c:otherwise></c:choose></td></tr></c:forEach></tbody></table></div></c:when><c:otherwise><p class="muted">No order refund requests have been submitted.</p></c:otherwise></c:choose></section>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
