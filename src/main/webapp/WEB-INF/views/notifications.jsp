<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Notifications"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">YOUR UPDATES</div><h1>Notifications</h1><p>Appointment, pharmacy, and account updates.</p></div><form method="post" action="${pageContext.request.contextPath}/notifications"><input type="hidden" name="csrfToken" value="${csrfToken}"><button class="button button-outline" type="submit">Mark all as read</button></form></section><div class="notification-list"><c:forEach var="item" items="${notifications}"><article class="notification-card <c:if test='${not item.read}'>notification-unread</c:if>"><span class="notification-symbol">✦</span><div><strong><c:out value="${item.title}"/></strong><p><c:out value="${item.body}"/></p><small><c:out value="${item.createdAt}"/></small></div><c:if test="${not item.read}"><span class="unread-dot"></span></c:if></article></c:forEach><c:if test="${empty notifications}"><div class="empty-state"><span>♧</span><h3>You're all caught up</h3><p>New account updates will appear here.</p></div></c:if></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
