<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Medicine details"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="breadcrumb"><a href="${pageContext.request.contextPath}/medicines">Pharmacy</a><span>›</span><c:out value="${medicine.name}"/></div><section class="medicine-detail"><div class="medicine-illustration detail-art"><c:choose><c:when test="${not empty medicine.imageUrl}"><img class="medicine-photo" src="${pageContext.request.contextPath}${medicine.imageUrl}" alt="Medicine product"></c:when><c:otherwise><span class="medicine-shape">✚</span></c:otherwise></c:choose></div><div><div class="eyebrow"><c:out value="${medicine.category}"/></div><h1><c:out value="${medicine.name}"/></h1><p class="muted"><c:out value="${medicine.manufacturer}"/></p><p class="lead-copy"><c:out value="${medicine.description}"/></p><div class="detail-price"><c:choose><c:when test="${medicine.price gt 0}">₹<c:out value="${medicine.price}"/></c:when><c:otherwise>Price to be confirmed</c:otherwise></c:choose></div><p><span class="pill pill-stock"><c:choose><c:when test="${medicine.price gt 0}"><c:out value="${medicine.stock}"/> available</c:when><c:otherwise>Not available</c:otherwise></c:choose></span><c:if test="${medicine.prescriptionRequired}"><span class="pill pill-rx">Prescription required</span></c:if></p><c:if test="${medicine.price gt 0 and medicine.stock gt 0}"><form method="post" action="${pageContext.request.contextPath}/cart" class="add-detail-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="medicineId" value="${medicine.id}"><input type="hidden" name="action" value="add"><label>Quantity<input type="number" name="quantity" value="1" min="1" max="30"></label><button class="button" type="submit">Add to cart <span>＋</span></button></form></c:if><c:if test="${medicine.price le 0}"><p class="care-disclaimer"><strong>Not ready for sale</strong><br>The pharmacy must confirm this product’s price, package, directions, stock, and prescription status first.</p></c:if><c:if test="${medicine.prescriptionRequired}"><p class="care-disclaimer"><strong>Prescription verification required</strong><br>A doctor-issued prescription verified by the pharmacist is required at checkout for this item.</p></c:if></div></section>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
