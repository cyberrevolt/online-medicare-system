<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Return pickups"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">DELIVERY WORKSPACE</div><h1>Return pickups</h1><p>Visit the patient at the scheduled time, collect the return product, and record the pickup.</p></div><div class="page-intro-actions"><a class="button button-outline" href="${pageContext.request.contextPath}/delivery">Delivery queue</a><a class="button button-outline" href="${pageContext.request.contextPath}/dashboard">Dashboard</a></div></section>
<c:choose><c:when test="${not empty returnPickups}"><section class="return-queue" aria-label="Assigned return pickups"><c:forEach var="r" items="${returnPickups}"><article class="panel-card return-card"><div class="return-card-heading"><div><span class="eyebrow">RETURN PICKUP · ORDER #<c:out value="${r.orderId}"/></span><h2><c:out value="${r.patient}"/></h2><p><strong>Scheduled:</strong> <c:out value="${r.pickupScheduledAt}"/></p></div><span class="pill">SCHEDULED</span></div><div class="return-info-grid"><div><strong>Patient contact</strong><span><a href="tel:${r.patientPhone}"><c:out value="${r.patientPhone}"/></a></span><strong>Pickup address</strong><span><c:out value="${r.address}"/><br><c:out value="${r.city}"/><c:if test="${not empty r.district}">, <c:out value="${r.district}"/></c:if><br><c:out value="${r.state}"/> <c:out value="${r.postalCode}"/></span><strong>Return reason</strong><span><c:out value="${r.reason}"/></span></div><div><strong>Product lines</strong><ul class="patient-order-items"><c:forEach var="item" items="${r.items}"><li><span><c:out value="${item.name}"/> × <c:out value="${item.quantity}"/></span></li></c:forEach></ul><form method="post" action="${pageContext.request.contextPath}/delivery/return-pickups" class="pickup-complete-form" data-confirm="Confirm that you collected this return product?"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="markPickedUp"><input type="hidden" name="orderId" value="${r.orderId}"><button class="button" type="submit">Mark product picked up</button></form></div></div></article></c:forEach></section></c:when><c:otherwise><div class="empty-state"><span>✓</span><h3>No return pickups assigned</h3><p>When the pharmacy assigns you a return pickup, the schedule and patient details will appear here.</p></div></c:otherwise></c:choose>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
