<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Dashboard"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="dashboard-welcome"><div><div class="eyebrow">${sessionScope.user.role} WORKSPACE</div><h1>Hello, <c:out value="${sessionScope.user.fullName}"/></h1><p>Here’s your Online Medic overview.</p></div><a class="notification-badge" href="${pageContext.request.contextPath}/notifications" aria-label="Open notifications, ${unread} unread"><span aria-hidden="true">♧</span><span><c:out value="${unread}"/> unread</span></a></section>
<c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}"><div class="stats-grid"><div class="stat-card"><span>Patients</span><strong><c:out value="${stats.patients}"/></strong><small>registered accounts</small></div><div class="stat-card"><span>Doctors</span><strong><c:out value="${stats.doctors}"/></strong><small>active professionals</small></div><div class="stat-card"><span>Pharmacy team</span><strong><c:out value="${stats.pharmacists}"/></strong><small>pharmacists</small></div><div class="stat-card"><span>Delivery team</span><strong><c:out value="${stats.delivery}"/></strong><small>staff accounts</small></div><div class="stat-card"><span>Medicines</span><strong><c:out value="${stats.medicines}"/></strong><small>catalogue items</small></div><div class="stat-card"><span>Orders</span><strong><c:out value="${stats.orders}"/></strong><small>all time</small></div><div class="stat-card"><span>Appointments</span><strong><c:out value="${stats.appointments}"/></strong><small>all time</small></div><div class="stat-card"><span>Low stock</span><strong><c:out value="${stats.lowStock}"/></strong><small>at or below threshold</small></div></div><div class="dashboard-panels"><div class="panel-card"><span class="eyebrow">ADMINISTRATION</span><h2>System overview</h2><p>Review live counts from the configured database. Demo seed records are clearly identified in the README.</p><div class="panel-actions"><a class="button button-soft" href="${pageContext.request.contextPath}/admin">Open admin tools →</a></div></div><div class="panel-card panel-tint"><span class="eyebrow">PAYMENTS</span><h2>₹<c:out value="${stats.revenue}"/> recorded</h2><p>Successful demo transactions only. No real money is moved.</p><span class="pill pill-green">${stats.pending} orders in progress</span></div></div></c:when>
<c:when test="${sessionScope.user.role eq 'DOCTOR'}"><div class="stats-grid stats-four"><div class="stat-card"><span>Today's visits</span><strong><c:out value="${stats.today}"/></strong><small>pending or confirmed</small></div><div class="stat-card"><span>Upcoming</span><strong><c:out value="${stats.upcoming}"/></strong><small>appointments</small></div><div class="stat-card"><span>Completed</span><strong><c:out value="${stats.completed}"/></strong><small>consultations</small></div><div class="stat-card"><span>Patients</span><strong><c:out value="${stats.patients}"/></strong><small>seen in this system</small></div><div class="stat-card"><span>Consultation earnings</span><strong>₹<c:out value="${stats.earnings}"/></strong><small>successful demo payments only</small></div><div class="stat-card"><span>Prescriptions awaiting review</span><strong><c:out value="${stats.prescriptions}"/></strong><small>issued to patients</small></div></div><div class="panel-card"><div class="results-heading"><div><span class="eyebrow">YOUR SCHEDULE</span><h2>Appointments and private rooms</h2></div><div class="panel-actions"><a class="button button-small button-outline" href="${pageContext.request.contextPath}/doctor/availability">Manage availability</a><a class="button button-small" href="${pageContext.request.contextPath}/doctor/appointments">Manage appointments →</a></div></div><p class="muted">Open confirmed visits for chat or video. Completed visits remain available for review.</p><jsp:include page="/WEB-INF/views/common/appointment-table.jsp"/></div></c:when>
<c:when test="${sessionScope.user.role eq 'PATIENT'}"><div class="stats-grid stats-four"><div class="stat-card"><span>Appointments</span><strong><c:out value="${stats.appointments}"/></strong><small>all time</small></div><div class="stat-card"><span>Upcoming visits</span><strong><c:out value="${stats.upcoming}"/></strong><small>confirmed</small></div><div class="stat-card"><span>Pharmacy orders</span><strong><c:out value="${stats.orders}"/></strong><small>all time</small></div><div class="stat-card"><span>Prescriptions</span><strong><c:out value="${stats.prescriptions}"/></strong><small>issued to you</small></div></div><div class="dashboard-shortcuts"><a href="${pageContext.request.contextPath}/doctors"><span>⌕</span><strong>Find a doctor</strong><small>Book your next consultation</small><b>→</b></a><a href="${pageContext.request.contextPath}/medicines"><span>✚</span><strong>Browse pharmacy</strong><small>Shop available essentials</small><b>→</b></a><a href="${pageContext.request.contextPath}/appointments"><span>◷</span><strong>Appointments and rooms</strong><small>Review visits, chat, or video call your doctor</small><b>→</b></a><a href="${pageContext.request.contextPath}/patient/profile"><span>⌂</span><strong>Profile and addresses</strong><small>Keep your contact and delivery details current</small><b>→</b></a></div><div class="dashboard-panels"><div class="panel-card"><div class="results-heading"><div><span class="eyebrow">YOUR SCHEDULE</span><h2>Recent appointments</h2></div><a class="text-link" href="${pageContext.request.contextPath}/appointments">View all →</a></div><jsp:include page="/WEB-INF/views/common/appointment-table.jsp"/></div><div class="panel-card"><span class="eyebrow">PHARMACY</span><h2>Your recent orders</h2><c:choose><c:when test="${not empty orders}"><c:forEach var="order" items="${orders}" end="3"><div class="order-line"><div><strong>Order #<c:out value="${order.id}"/></strong><span><c:out value="${order.createdAt.toLocalDate()}"/> · <c:out value="${order.paymentMethod}"/></span></div><div><strong>₹<c:out value="${order.total}"/></strong><span class="pill"><c:out value="${order.status}"/></span></div></div></c:forEach><a class="text-link" href="${pageContext.request.contextPath}/orders">View order history →</a></c:when><c:otherwise><p class="muted">Your orders will appear here when placed.</p><a class="text-link" href="${pageContext.request.contextPath}/medicines">Browse pharmacy →</a></c:otherwise></c:choose></div></div></c:when>
<c:when test="${sessionScope.user.role eq 'PHARMACIST'}"><div class="stats-grid stats-four"><div class="stat-card"><span>Catalogue</span><strong><c:out value="${stats.medicines}"/></strong><small>medicines</small></div><div class="stat-card"><span>Orders</span><strong><c:out value="${stats.orders}"/></strong><small>all time</small></div><div class="stat-card"><span>In progress</span><strong><c:out value="${stats.pending}"/></strong><small>orders</small></div><div class="stat-card"><span>Low stock</span><strong><c:out value="${stats.lowStock}"/></strong><small>items to review</small></div></div><div class="panel-card"><span class="eyebrow">PHARMACY OPERATIONS</span><h2>Manage your pharmacy</h2><p>Update your storefront profile, add medicines, configure starter listings, and restock inventory.</p><div class="panel-actions"><a class="button button-soft" href="${pageContext.request.contextPath}/pharmacist/manage">Manage pharmacy →</a><a class="text-link" href="${pageContext.request.contextPath}/pharmacist/orders">Process orders →</a><a class="text-link" href="${pageContext.request.contextPath}/prescriptions">Review prescriptions →</a><a class="text-link" href="${pageContext.request.contextPath}/pharmacist/returns">Manage returns →</a></div></div></c:when>
<c:otherwise><div class="panel-card"><span class="eyebrow">DELIVERY WORKSPACE</span><h2>Assigned deliveries</h2><p>See orders awaiting pickup and update delivery progress.</p><div class="panel-actions"><a class="button" href="${pageContext.request.contextPath}/delivery">Open delivery queue →</a><a class="button button-outline" href="${pageContext.request.contextPath}/delivery/return-pickups">Return pickups →</a></div></div></c:otherwise></c:choose>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
