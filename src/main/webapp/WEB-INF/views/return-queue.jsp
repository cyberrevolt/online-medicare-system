<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Return requests"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">PHARMACY OPERATIONS</div><h1>Return requests</h1><p>Review return eligibility, request a product photo, then schedule an assigned pickup when verification passes.</p></div><div class="page-intro-actions"><a class="button button-outline" href="${pageContext.request.contextPath}/pharmacist/orders">Order queue</a><a class="button button-outline" href="${pageContext.request.contextPath}/dashboard">Dashboard</a></div></section>
<c:choose><c:when test="${not empty returnQueue}"><section class="return-queue" aria-label="Patient return requests"><c:forEach var="r" items="${returnQueue}">
  <article class="panel-card return-card"><div class="return-card-heading"><div><span class="eyebrow">ORDER #<c:out value="${r.orderId}"/></span><h2><c:out value="${r.patient}"/></h2><p class="muted">Requested <c:out value="${r.requestedAt}"/> · Delivered <c:out value="${r.deliveredAt}"/></p></div><span class="pill"><c:out value="${r.status}"/></span></div>
    <div class="return-info-grid"><div><strong>Patient contact</strong><span><c:out value="${r.patientPhone}"/></span><strong>Pickup address</strong><span><c:out value="${r.address}"/><br><c:out value="${r.city}"/><c:if test="${not empty r.district}">, <c:out value="${r.district}"/></c:if><br><c:out value="${r.state}"/> <c:out value="${r.postalCode}"/></span></div><div><strong>Patient reason</strong><span><c:choose><c:when test="${not empty r.reason}"><c:out value="${r.reason}"/></c:when><c:otherwise>No reason entered.</c:otherwise></c:choose></span><strong>Items in order</strong><ul class="patient-order-items"><c:forEach var="item" items="${r.items}"><li><span><c:out value="${item.name}"/> × <c:out value="${item.quantity}"/></span></li></c:forEach></ul></div></div>
    <c:if test="${r.imageUploaded}"><div class="return-proof"><strong>Patient product photo</strong><c:url var="returnPhotoUrl" value="/pharmacist/return-photo"><c:param name="id" value="${r.orderId}"/></c:url><a href="${returnPhotoUrl}" target="_blank" rel="noopener"><img src="${returnPhotoUrl}" alt="Product photo submitted for return order ${r.orderId}"></a><small>Uploaded <c:out value="${r.imageUploadedAt}"/></small></div></c:if>
    <c:if test="${r.status eq 'REQUESTED'}"><div class="return-actions-grid">
      <div class="return-action-panel"><h3>Photo verification</h3><c:choose><c:when test="${r.imageRequired and not r.imageUploaded}"><p class="muted">A photo has been requested. Waiting for the patient to upload it.</p></c:when><c:when test="${r.imageUploaded}"><p class="muted">Review the uploaded photo above. If it passes, schedule a pickup.</p></c:when><c:otherwise><p class="muted">Request a photo if you need visual verification before deciding.</p><form method="post" action="${pageContext.request.contextPath}/pharmacist/returns" class="form-stack compact-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="requestImage"><input type="hidden" name="orderId" value="${r.orderId}"><label>Instructions for patient <span class="optional">Optional</span><textarea name="note" rows="2" maxlength="500" placeholder="Please photograph the product and packaging"></textarea></label><button class="button button-small button-outline" type="submit">Request product photo</button></form></c:otherwise></c:choose></div>
      <div class="return-action-panel"><h3>Eligibility decision</h3><p class="muted">Approving assigns a pickup and puts the task in that staff member’s return queue.</p><c:if test="${empty deliveryStaff}"><p class="alert alert-error">No active delivery staff with a phone number is available. Ask an administrator to add one before scheduling pickup.</p></c:if><c:choose><c:when test="${r.imageRequired and not r.imageUploaded}"><p class="muted">Approval is available after the requested photo arrives.</p></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/pharmacist/returns" class="form-stack compact-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="approveSchedule"><input type="hidden" name="orderId" value="${r.orderId}"><label>Pickup date and time<input type="datetime-local" name="pickupAt" required></label><label>Assign delivery staff<select name="deliveryStaffId" required><option value="" selected disabled>Choose staff</option><c:forEach var="staff" items="${deliveryStaff}"><option value="${staff.id}"><c:out value="${staff.name}"/> · <c:out value="${staff.phone}"/></option></c:forEach></select></label><label>Note <span class="optional">Optional</span><textarea name="note" rows="2" maxlength="500" placeholder="Verification passed"></textarea></label><button class="button button-small" type="submit">Approve and schedule pickup</button></form></c:otherwise></c:choose>
        <form method="post" action="${pageContext.request.contextPath}/pharmacist/returns" class="form-stack compact-form reject-return-form" data-confirm="Decline this return request?"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="reject"><input type="hidden" name="orderId" value="${r.orderId}"><label>Reason if declining <textarea name="note" rows="2" maxlength="500" required placeholder="Explain why the product is not eligible"></textarea></label><button class="button button-small button-danger" type="submit">Decline return</button></form>
      </div>
    </div></c:if>
    <c:if test="${r.status eq 'APPROVED'}"><div class="return-request-note"><strong>Pickup <c:out value="${r.pickupStatus}"/></strong><p>Scheduled: <c:out value="${r.pickupScheduledAt}"/></p><p>Assigned staff: <c:out value="${r.pickupStaffName}"/> · <c:out value="${r.pickupStaffPhone}"/></p><c:if test="${r.pickupStatus eq 'PICKED_UP'}"><p>Collected: <c:out value="${r.pickupCompletedAt}"/></p><form method="post" action="${pageContext.request.contextPath}/pharmacist/returns" class="form-stack compact-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="markReceived"><input type="hidden" name="orderId" value="${r.orderId}"><label>Receipt note <span class="optional">Optional</span><textarea name="note" rows="2" maxlength="500" placeholder="Product received and checked"></textarea></label><button class="button button-small" type="submit">Confirm product received</button></form></c:if></div></c:if>
    <c:if test="${r.status eq 'RECEIVED'}"><div class="return-request-note"><strong>Return received</strong><p><c:out value="${r.reviewNote}"/></p><c:choose><c:when test="${r.refundStatus eq 'PENDING'}"><p>Refund request is waiting for administrator review.</p></c:when><c:when test="${r.refundStatus eq 'APPROVED'}"><p>Refund approved; administrator must mark it processed. This demo does not transfer money.</p></c:when><c:when test="${r.refundStatus eq 'PROCESSED'}"><p>Full demo refund marked processed. No bank transfer was made.</p></c:when><c:when test="${r.refundStatus eq 'REJECTED'}"><p>The previous refund request was declined. You may submit a new request if the return remains eligible.</p></c:when></c:choose></div><c:if test="${empty r.refundStatus or r.refundStatus eq 'REJECTED'}"><form method="post" action="${pageContext.request.contextPath}/pharmacist/returns" class="form-stack compact-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="initiateRefund"><input type="hidden" name="orderId" value="${r.orderId}"><label>Refund note <span class="optional">Optional · full demo refund, subject to administrator review</span><textarea name="reason" rows="2" maxlength="500" placeholder="Return received and verified"></textarea></label><button class="button button-small" type="submit">Initiate full refund</button></form></c:if></c:if>
    <c:if test="${r.status eq 'REJECTED' or r.status eq 'REFUNDED'}"><div class="return-request-note"><strong>Return <c:out value="${r.status}"/></strong><c:if test="${not empty r.reviewNote}"><p><c:out value="${r.reviewNote}"/></p></c:if></div></c:if>
  </article>
</c:forEach></section></c:when><c:otherwise><div class="empty-state"><span>✓</span><h3>No return requests</h3><p>Patient return requests will appear here for eligibility review.</p></div></c:otherwise></c:choose>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
