<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Pharmacy"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">ONLINE MEDIC PHARMACY</div><h1>Everyday essentials, thoughtfully chosen.</h1><p>Browse available items from our demo catalogue. Check the label and consult a professional when needed.</p></div><a class="button button-outline" href="${pageContext.request.contextPath}/cart">View cart <span>→</span></a></section>
<section class="pharmacy-profile-strip"><c:choose><c:when test="${not empty pharmacyProfile.imageUrl}"><img src="${pageContext.request.contextPath}${pharmacyProfile.imageUrl}" alt="Pharmacy profile"></c:when><c:otherwise><img class="pharmacy-cover" src="${pageContext.request.contextPath}/assets/catalog/pharmacy-background.jpg" alt="Online pharmacy"></c:otherwise></c:choose><div><span class="eyebrow">PHARMACY</span><h2><c:choose><c:when test="${not empty pharmacyProfile.name}"><c:out value="${pharmacyProfile.name}"/></c:when><c:otherwise>Online Medic Pharmacy</c:otherwise></c:choose></h2><p>Browse medicines and everyday health essentials.</p></div></section>
<section class="catalog-categories" aria-label="Shop by category"><h2>Shop by category</h2><div class="catalog-category-grid"><a class="catalog-category-card" href="${pageContext.request.contextPath}/medicines?category=Skin%20care"><img src="${pageContext.request.contextPath}/assets/catalog/skin-treatment.jpg" alt=""><span>Skin care</span></a><a class="catalog-category-card" href="${pageContext.request.contextPath}/medicines?category=Pain%20relief"><img src="${pageContext.request.contextPath}/assets/catalog/pain-relief.jpg" alt=""><span>Pain relief</span></a><a class="catalog-category-card" href="${pageContext.request.contextPath}/medicines?category=Vitamins%20%26%20supplements"><img src="${pageContext.request.contextPath}/assets/catalog/vitamins.jpg" alt=""><span>Vitamins &amp; supplements</span></a><a class="catalog-category-card" href="${pageContext.request.contextPath}/medicines?category=Cold%20%26%20allergy"><img src="${pageContext.request.contextPath}/assets/catalog/cold-allergy.jpg" alt=""><span>Cold &amp; allergy</span></a></div></section>
<form class="filter-bar" method="get" action="${pageContext.request.contextPath}/medicines"><label class="search-field"><span>⌕</span><input name="q" placeholder="Search the catalogue" aria-label="Search medicines" value="<c:out value='${param.q}'/>"></label><label class="select-field"><span class="sr-only">Category</span><select name="category"><option value="">All categories</option><c:forEach var="item" items="${categories}"><option value="<c:out value='${item}'/>" <c:if test="${param.category eq item}">selected</c:if>><c:out value="${item}"/></option></c:forEach></select></label><label class="select-field"><span class="sr-only">Sort by</span><select name="sort"><option value="">Name</option><option value="price" <c:if test="${param.sort eq 'price'}">selected</c:if>>Price: low to high</option></select></label><button class="button" type="submit">Search</button></form>
<div class="results-heading"><h2>Browse medicines</h2><span class="result-count"><c:out value="${medicines.size()}"/> items</span></div><div class="medicine-grid"><c:forEach var="item" items="${medicines}"><article class="medicine-card"><div class="medicine-illustration"><c:choose><c:when test="${not empty item.imageUrl}"><img class="medicine-photo" src="${pageContext.request.contextPath}${item.imageUrl}" alt="Medicine product"></c:when><c:otherwise><span class="medicine-shape">✚</span></c:otherwise></c:choose><span class="pill pill-stock"><c:choose><c:when test="${item.price gt 0}"><c:out value="${item.stock}"/> in stock</c:when><c:otherwise>Setup required</c:otherwise></c:choose></span></div><div class="medicine-body"><div class="medicine-meta"><span><c:out value="${item.category}"/></span><c:if test="${item.prescriptionRequired}"><span class="pill pill-rx">Prescription</span></c:if></div><h3><c:out value="${item.name}"/></h3><p><c:out value="${item.description}"/></p><div class="medicine-bottom"><strong class="price"><c:choose><c:when test="${item.price gt 0}">₹<c:out value="${item.price}"/></c:when><c:otherwise>Price to be confirmed</c:otherwise></c:choose></strong><a class="text-link" href="${pageContext.request.contextPath}/medicines?id=${item.id}">Details →</a></div><c:choose><c:when test="${item.price gt 0 and item.stock gt 0}"><form method="post" action="${pageContext.request.contextPath}/cart" class="add-cart-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="medicineId" value="${item.id}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="action" value="add"><button class="button button-full button-soft" type="submit">Add to cart <span>＋</span></button></form></c:when><c:when test="${item.price le 0}"><span class="blocked-note">Pharmacy setup required</span></c:when><c:otherwise><span class="blocked-note">Currently unavailable</span></c:otherwise></c:choose></div></article></c:forEach><c:if test="${empty medicines}"><div class="empty-state"><span>⌕</span><h3>No items found</h3><p>Try a different product name or category.</p><a class="text-link" href="${pageContext.request.contextPath}/medicines">Clear filters →</a></div></c:if></div>
<div class="care-disclaimer wide-disclaimer"><strong>Medicine safety</strong><p>Use medicines only as directed on the packaging or by a qualified healthcare professional. This catalogue is seeded demo data for demonstration purposes.</p></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
