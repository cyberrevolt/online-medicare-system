<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Manage appointments"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">DOCTOR WORKSPACE</div><h1>Manage appointments</h1><p>Review patient bookings, open private chat or video rooms, and document completed visits.</p></div><div class="panel-actions"><a class="button button-outline" href="${pageContext.request.contextPath}/doctor/availability">Manage availability</a><a class="button button-outline" href="${pageContext.request.contextPath}/dashboard">Back to dashboard</a></div></section>
<div class="table-card"><c:choose><c:when test="${not empty appointments}"><div class="table-scroll"><table><thead><tr><th>Patient</th><th>Schedule</th><th>Type</th><th>Status</th><th>Payment</th><th>Actions</th></tr></thead><tbody><c:forEach var="a" items="${appointments}"><tr>
  <td><strong><c:out value="${a.doctorName}"/></strong></td><td><c:out value="${a.date}"/><br><span class="muted"><c:out value="${a.time}"/></span></td><td><c:out value="${a.type}"/></td><td><span class="pill"><c:out value="${a.status}"/></span></td><td><c:out value="${a.paymentStatus}"/></td><td>
    <c:if test="${a.status eq 'CONFIRMED'}"><a class="text-link" href="${pageContext.request.contextPath}/consultation?id=${a.id}">Open appointment room →</a></c:if><c:if test="${a.status eq 'COMPLETED'}"><a class="text-link" href="${pageContext.request.contextPath}/consultation?id=${a.id}">Review completed visit →</a></c:if>
    <c:if test="${a.status eq 'CONFIRMED'}"><form method="post" action="${pageContext.request.contextPath}/doctor/appointments" class="inline-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="appointmentId" value="${a.id}"><button class="text-link" name="status" value="COMPLETED">Mark completed</button><button class="text-link danger-link" name="status" value="NO_SHOW">Mark no-show</button></form></c:if>
    <c:if test="${a.status eq 'PENDING'}"><span class="muted tiny">Waiting for patient demo payment</span></c:if></td></tr></c:forEach></tbody></table></div></c:when>
  <c:otherwise><div class="empty-state"><span>◷</span><h3>No appointments yet</h3><p>Once a patient books an open time and completes the demo payment, the visit will appear here.</p><a class="button button-soft" href="${pageContext.request.contextPath}/doctor/availability">Add available times</a></div></c:otherwise></c:choose></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
