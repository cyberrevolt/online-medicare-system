<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Add a doctor"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">ADMIN CONSOLE</div><h1>Add a doctor</h1><p>Create a professional account and profile. The doctor can set appointment availability after signing in.</p></div><a class="button button-outline" href="${pageContext.request.contextPath}/admin">Admin dashboard</a></section><section class="panel-card admin-form-card"><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/admin/doctors" class="form-stack" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${csrfToken}"><div class="form-row"><label>Full name<input name="name" required minlength="2" maxlength="120"></label><label>Email address<input type="email" name="email" required maxlength="190"></label></div><div class="form-row"><label>Phone<input name="phone" maxlength="30"></label><label>Temporary password<input type="password" name="password" required minlength="10" maxlength="128"></label></div><div class="form-row"><label>Specialization<input name="specialization" required maxlength="100"></label><label>Qualification<input name="qualification" required maxlength="160"></label></div><div class="form-row"><label>Medical registration number<input name="registration" required maxlength="80"></label><label>Experience (years)<input type="number" name="experience" min="0" max="70" required></label></div><div class="form-row"><label>Consultation fee (₹)<input type="number" name="fee" min="0" max="100000" step="0.01" required></label><label>Clinic name<input name="clinic" maxlength="180"></label></div><label>About<textarea name="about" rows="3" maxlength="1200"></textarea></label><label>Doctor profile image (optional, JPEG or PNG, max 5 MB)<input type="file" name="profileImage" accept="image/jpeg,image/png"></label><button class="button" type="submit">Create doctor account <span>→</span></button></form></section>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
