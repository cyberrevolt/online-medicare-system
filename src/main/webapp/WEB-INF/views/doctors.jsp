<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Find a doctor"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">DOCTOR DIRECTORY</div><h1>Find care that fits your needs.</h1><p>Browse professionals and clearly marked fictional demo profiles. Confirmed appointments include a private patient–doctor room for chat and one-to-one video.</p></div><div class="intro-mark">✚</div></section>
<form class="filter-bar" method="get" action="${pageContext.request.contextPath}/doctors"><label class="search-field"><span>⌕</span><input name="q" value="<c:out value='${param.q}'/>" placeholder="Search name, speciality, qualification" aria-label="Search doctors"></label><label class="select-field"><span class="sr-only">Speciality</span><select name="specialty"><option value="">All specialities</option><c:forEach var="item" items="${specializations}"><option value="<c:out value='${item}'/>" <c:if test="${param.specialty eq item}">selected</c:if>><c:out value="${item}"/></option></c:forEach></select></label><label class="select-field"><span class="sr-only">Sort by</span><select name="sort"><option value="">Top rated</option><option value="fee" <c:if test="${param.sort eq 'fee'}">selected</c:if>>Lowest fee</option><option value="experience" <c:if test="${param.sort eq 'experience'}">selected</c:if>>Most experienced</option></select></label><button class="button" type="submit">Search</button></form>
<div class="results-heading"><h2>Doctor profiles</h2><span class="result-count"><c:out value="${doctors.size()}"/> profiles</span></div>
<div class="doctor-grid"><c:forEach var="doctor" items="${doctors}"><article class="doctor-card"><div class="doctor-card-top"><c:choose><c:when test="${not empty doctor.profileImage}"><img class="doctor-photo doctor-card-photo" src="${pageContext.request.contextPath}${doctor.profileImage}" alt="Doctor profile photo"></c:when><c:otherwise><div class="doctor-avatar doctor-card-photo"><c:out value="${doctor.fullName.substring(4,5)}"/></div></c:otherwise></c:choose><c:choose><c:when test="${doctor.demoProfile}"><span class="pill pill-demo">Fictional demo · simulated</span></c:when><c:otherwise><span class="pill pill-green">Accepting patients</span></c:otherwise></c:choose></div>
  <h3><c:out value="${doctor.fullName}"/></h3><div class="specialty"><c:out value="${doctor.specialization}"/></div><p class="doctor-qualification"><c:out value="${doctor.qualification}"/></p>
  <div class="doctor-facts"><c:choose><c:when test="${doctor.demoProfile}"><span><strong>Demo booking</strong>chat and video</span><span><strong>Fictional</strong>not a real provider</span></c:when><c:otherwise><span><strong><c:out value="${doctor.experienceYears}"/> yrs</strong> experience</span><span><strong>★ <c:out value="${doctor.rating}"/></strong> rating</span></c:otherwise></c:choose></div>
  <div class="doctor-card-bottom"><div><span class="muted tiny"><c:choose><c:when test="${doctor.demoProfile}">SIMULATED FEE</c:when><c:otherwise>CONSULTATION</c:otherwise></c:choose></span><strong class="price">₹<c:out value="${doctor.fee}"/></strong></div><a class="button button-small" href="${pageContext.request.contextPath}/doctors?id=${doctor.id}">View profile <span>→</span></a></div></article></c:forEach>
  <c:if test="${empty doctors}"><div class="empty-state"><span>⌕</span><h3>No doctors match your search</h3><p>Try another name or speciality.</p><a class="text-link" href="${pageContext.request.contextPath}/doctors">Clear filters →</a></div></c:if></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
