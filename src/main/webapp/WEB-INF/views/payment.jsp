<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Demo payment"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="checkout-layout"><div><div class="eyebrow">SECURE CHECKOUT · DEMO MODE</div><h1>Confirm your consultation</h1><p class="muted">This local payment simulation records a demo transaction. No real money is moved.</p><div class="payment-summary"><div><span>Appointment reference</span><strong>#<c:out value="${appointmentId}"/></strong></div><div><span>Payment provider</span><strong>Online Medic Demo Gateway</strong></div></div></div><div class="checkout-card"><span class="icon-tile mint">✓</span><h2>Choose a demo result</h2><p>Simulate either outcome to see how appointment confirmation works.</p><form method="post" action="${pageContext.request.contextPath}/payment" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="appointmentId" value="${appointmentId}"><input type="hidden" name="method" value="DEMO_CARD"><label class="radio-card"><input type="radio" name="outcome" value="success" checked><span><strong>Simulate successful payment</strong><small>Appointment is confirmed and the slot is reserved.</small></span></label><label class="radio-card"><input type="radio" name="outcome" value="failure"><span><strong>Simulate declined payment</strong><small>Appointment is cancelled and the time slot is released.</small></span></label><button class="button button-full" type="submit">Continue <span>→</span></button></form><p class="fine-print">Demo only. This does not contact a bank or payment service.</p></div></section>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
