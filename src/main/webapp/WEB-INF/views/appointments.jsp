<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Appointments"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">PATIENT SPACE</div><h1>Your appointments</h1><p>Review bookings, continue pending demo payments, open confirmed appointment rooms, or manage an upcoming visit.</p></div><a class="button" href="${pageContext.request.contextPath}/doctors">Find a doctor <span>→</span></a></section>
<div class="table-card"><c:choose><c:when test="${not empty appointments}"><div class="table-scroll"><table><thead><tr><th>Doctor</th><th>Date and time</th><th>Consultation</th><th>Fee</th><th>Status</th><th>Payment</th><th>Actions</th></tr></thead><tbody><c:forEach var="a" items="${appointments}"><tr>
  <td><strong><c:out value="${a.doctorName}"/></strong></td><td><c:out value="${a.date}"/><br><span class="muted"><c:out value="${a.time}"/></span></td><td><c:out value="${a.type}"/></td><td>₹<c:out value="${a.fee}"/></td><td><span class="pill"><c:out value="${a.status}"/></span></td><td><c:out value="${a.paymentStatus}"/></td>
  <td><c:if test="${a.status eq 'PENDING' and a.paymentStatus eq 'PENDING'}"><a class="text-link" href="${pageContext.request.contextPath}/payment?appointment=${a.id}">Continue demo payment →</a></c:if>
    <c:if test="${a.status eq 'CONFIRMED'}"><a class="text-link" href="${pageContext.request.contextPath}/consultation?id=${a.id}">Open appointment room →</a></c:if>
    <c:if test="${a.status eq 'COMPLETED'}"><span class="muted tiny">Consultation complete · </span><a class="text-link" href="${pageContext.request.contextPath}/doctors">Book a new appointment →</a></c:if>
    <c:if test="${a.cancelEligible and a.status eq 'CONFIRMED'}"><form method="post" action="${pageContext.request.contextPath}/appointments" class="inline-form" data-confirm="Cancel this future appointment? The demo payment will be marked refunded."><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="cancel"><input type="hidden" name="appointmentId" value="${a.id}"><button class="text-link danger-link" type="submit">Cancel</button></form></c:if>
    <c:if test="${a.status eq 'COMPLETED' and not a.reviewed}"><form method="post" action="${pageContext.request.contextPath}/review" class="inline-form review-inline"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="appointmentId" value="${a.id}"><label><span class="sr-only">Rate doctor</span><select name="rating"><option value="5">5 stars</option><option value="4">4 stars</option><option value="3">3 stars</option><option value="2">2 stars</option><option value="1">1 star</option></select></label><input name="comment" maxlength="1000" placeholder="Comment (optional)"><button class="text-link" type="submit">Review</button></form></c:if>
    <c:if test="${a.reviewed}"><span class="muted tiny">Reviewed</span></c:if></td></tr></c:forEach></tbody></table></div></c:when>
  <c:otherwise><div class="empty-state"><span>◷</span><h3>No appointments yet</h3><p>Find a doctor and choose an available time slot.</p><a class="button" href="${pageContext.request.contextPath}/doctors">Browse doctors</a></div></c:otherwise></c:choose></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
