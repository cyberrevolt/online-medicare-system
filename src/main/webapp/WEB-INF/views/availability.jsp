<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Manage availability"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">DOCTOR WORKSPACE</div><h1>Manage availability</h1><p>Add, edit, or remove open appointment windows. A window with an active appointment is locked to protect the booking.</p></div><a class="button button-outline" href="${pageContext.request.contextPath}/dashboard">Dashboard</a></section>
<div class="dashboard-panels">
  <section class="panel-card"><span class="eyebrow">NEW WINDOW</span><h2>Add appointment time</h2><form method="post" action="${pageContext.request.contextPath}/doctor/availability" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="add"><label>Date<input type="date" name="date" min="${earliestDate}" max="${lastDate}" required></label><div class="form-row"><label>Start time<input type="time" name="start" required></label><label>End time<input type="time" name="end" required></label></div><button class="button" type="submit">Add availability</button><p class="fine-print">Dates can be scheduled up to 90 days ahead. Each start time is offered as one 30-minute slot.</p></form></section>
  <section class="panel-card"><span class="eyebrow">OPEN WINDOWS</span><h2>Upcoming availability</h2><c:choose><c:when test="${not empty availability}"><div class="availability-list"><c:forEach var="slot" items="${availability}"><article class="availability-item"><div class="availability-item-heading"><div><strong><c:out value="${slot.date}"/></strong><span><c:out value="${slot.start}"/>–<c:out value="${slot.end}"/></span></div><c:choose><c:when test="${slot.booked}"><span class="pill pill-rx">Appointment booked · locked</span></c:when><c:otherwise><span class="pill pill-green">Open</span></c:otherwise></c:choose></div><c:if test="${not slot.booked}"><details class="availability-edit"><summary>Edit window</summary><form method="post" action="${pageContext.request.contextPath}/doctor/availability" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="slotId" value="${slot.id}"><label>Date<input type="date" name="date" value="<c:out value='${slot.date}'/>" min="${earliestDate}" max="${lastDate}" required></label><div class="form-row"><label>Start time<input type="time" name="start" value="<c:out value='${slot.start}'/>" required></label><label>End time<input type="time" name="end" value="<c:out value='${slot.end}'/>" required></label></div><button class="button button-small" type="submit">Save changes</button></form></details><form method="post" action="${pageContext.request.contextPath}/doctor/availability" data-confirm="Remove this open availability window?" class="availability-remove"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="slotId" value="${slot.id}"><button class="text-link danger-link" type="submit">Remove</button></form></c:if></article></c:forEach></div></c:when><c:otherwise><p class="muted">No future appointment windows are scheduled.</p></c:otherwise></c:choose></section>
</div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
