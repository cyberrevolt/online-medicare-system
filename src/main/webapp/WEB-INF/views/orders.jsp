<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="pageTitle" value="Order history"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow">PATIENT SPACE</div><h1>My orders</h1><p>See every order, follow its progress, download an invoice, or request a cancellation or return when eligible.</p></div><a class="button" href="${pageContext.request.contextPath}/medicines">Browse pharmacy</a></section>

<c:choose>
  <c:when test="${not empty orders}">
    <section class="patient-orders" aria-label="All of your pharmacy orders">
      <c:forEach var="o" items="${orders}">
        <article class="patient-order-card">
          <div class="patient-order-heading">
            <div><span class="eyebrow">ORDER #<c:out value="${o.id}"/></span><h2><c:out value="${o.createdAt}"/></h2></div>
            <div class="patient-order-state"><span class="pill"><c:out value="${o.status}"/></span><strong>₹<c:out value="${o.total}"/></strong></div>
          </div>
          <div class="patient-order-summary"><span><c:out value="${o.items.size()}"/> product line(s)</span><span><c:out value="${o.paymentMethod}"/> · <c:out value="${o.paymentStatus}"/></span><c:if test="${not empty o.prescriptionStatus}"><span>Prescription: <c:out value="${o.prescriptionStatus}"/></span></c:if><c:if test="${not empty o.returnStatus}"><span>Return: <c:out value="${o.returnStatus}"/></span></c:if><c:if test="${not empty o.refundStatus}"><span>Refund: <c:out value="${o.refundStatus}"/></span></c:if></div>
          <c:url var="invoiceUrl" value="/orders/invoice"><c:param name="id" value="${o.id}"/></c:url>
          <div class="patient-order-actions"><a class="button button-outline button-small" href="${invoiceUrl}">Download invoice PDF</a>
            <c:if test="${o.canCancel}"><form method="post" action="${pageContext.request.contextPath}/orders" data-confirm="Cancel this order?" class="inline-action-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="cancel"><input type="hidden" name="orderId" value="${o.id}"><button class="button button-small button-danger" type="submit">Cancel order</button></form></c:if>
          </div>
          <c:if test="${not empty o.refundStatus}"><div class="return-request-note"><strong>Refund request: <c:out value="${o.refundStatus}"/></strong><c:if test="${not empty o.refundAmount}"><p>Amount: ₹<c:out value="${o.refundAmount}"/> (full order payment)</p></c:if><c:choose><c:when test="${o.refundStatus eq 'PENDING'}"><p>Waiting for administrator review.</p></c:when><c:when test="${o.refundStatus eq 'APPROVED'}"><p>Approved and waiting to be marked processed by the administrator.</p></c:when><c:when test="${o.refundStatus eq 'REJECTED'}"><p><c:out value="${o.refundReviewNote}"/></p></c:when><c:when test="${o.refundStatus eq 'PROCESSED'}"><p>Marked processed in this demo. No bank transfer was made.</p></c:when></c:choose></div></c:if>
          <details class="patient-order-details"><summary>Track order and view items</summary>
            <div class="order-detail-grid">
              <section><h3>Delivery address</h3><p><c:out value="${o.addressLine}"/><br><c:out value="${o.city}"/><c:if test="${not empty o.district}">, <c:out value="${o.district}"/></c:if><br><c:out value="${o.state}"/> <c:out value="${o.postalCode}"/></p><p class="muted">Tracking updates appear as the pharmacy and delivery team progress the order.</p><c:if test="${o.status eq 'OUT_FOR_DELIVERY' and not empty o.deliveryStaffPhone}"><div class="delivery-contact-card"><strong>Out for delivery</strong><span><c:out value="${o.deliveryStaffName}"/></span><span>Delivery contact: <c:out value="${o.deliveryStaffPhone}"/></span></div></c:if></section>
              <section><h3>Order items</h3><ul class="patient-order-items"><c:forEach var="item" items="${o.items}"><li><span><c:out value="${item.name}"/> × <c:out value="${item.quantity}"/></span><strong>₹<c:out value="${item.lineTotal}"/></strong></li></c:forEach></ul><div class="patient-order-total"><span>Items</span><strong>₹<c:out value="${o.subtotal}"/></strong></div><div class="patient-order-total"><span>Delivery</span><strong><c:choose><c:when test="${o.deliveryFee eq 0}">Free</c:when><c:otherwise>₹<c:out value="${o.deliveryFee}"/></c:otherwise></c:choose></strong></div></section>
            </div>
            <section class="order-timeline-section"><h3>Order timeline</h3><ol class="order-timeline"><c:forEach var="event" items="${o.timeline}"><li><span class="timeline-dot"></span><div><strong><c:out value="${event.status}"/></strong><c:if test="${not empty event.note}"><p><c:out value="${event.note}"/></p></c:if><time><c:out value="${event.changedAt}"/></time></div></li></c:forEach></ol></section>
          </details>
          <c:if test="${o.canReturn}"><form method="post" action="${pageContext.request.contextPath}/orders" class="return-request-form" data-confirm="Submit a return request for this delivered order?"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="requestReturn"><input type="hidden" name="orderId" value="${o.id}"><label>Return reason <span class="optional">Optional · request within seven days of delivery (<c:out value="${o.returnDaysRemaining}"/> day(s) remaining)</span><textarea name="reason" rows="2" maxlength="500" placeholder="Tell the pharmacy why you are requesting a return"></textarea></label><button class="button button-small button-danger" type="submit">Request a return</button></form></c:if>
          <c:if test="${o.returnStatus eq 'REQUESTED'}"><div class="return-request-note"><strong>Return request submitted</strong><p>Submitted on <c:out value="${o.returnRequestedAt}"/>. The pharmacy is reviewing eligibility.</p>
            <c:if test="${o.returnImageRequired and not o.returnImageUploaded}"><p><c:choose><c:when test="${not empty o.returnReviewNote}"><c:out value="${o.returnReviewNote}"/></c:when><c:otherwise>The pharmacy needs a clear photo of the product and packaging for verification.</c:otherwise></c:choose></p><form method="post" action="${pageContext.request.contextPath}/orders" enctype="multipart/form-data" class="return-photo-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="uploadReturnImage"><input type="hidden" name="orderId" value="${o.id}"><label>Upload product photo <span class="optional">JPEG or PNG, up to 5 MB</span><input type="file" name="returnPhoto" accept="image/jpeg,image/png" required></label><button class="button button-small" type="submit">Upload photo</button></form></c:if>
            <c:if test="${o.returnImageUploaded}"><p>Product photo uploaded on <c:out value="${o.returnImageUploadedAt}"/>. Waiting for pharmacy review.</p></c:if>
          </div></c:if>
          <c:if test="${o.returnStatus eq 'APPROVED'}"><div class="return-request-note"><strong>Return approved</strong><p><c:out value="${o.returnReviewNote}"/></p><c:if test="${o.pickupStatus eq 'SCHEDULED'}"><p>Pickup scheduled: <strong><c:out value="${o.pickupScheduledAt}"/></strong></p><c:if test="${not empty o.pickupStaffName}"><p>Pickup staff: <c:out value="${o.pickupStaffName}"/><c:if test="${not empty o.pickupStaffPhone}"> · Contact <a href="tel:${o.pickupStaffPhone}"><c:out value="${o.pickupStaffPhone}"/></a></c:if></p></c:if></c:if><c:if test="${o.pickupStatus eq 'PICKED_UP'}"><p>The product was collected on <c:out value="${o.pickupCompletedAt}"/> and is awaiting pharmacy receipt confirmation.</p></c:if></div></c:if>
          <c:if test="${o.returnStatus eq 'REJECTED'}"><div class="return-request-note"><strong>Return not approved</strong><p><c:out value="${o.returnReviewNote}"/></p></div></c:if>
          <c:if test="${o.returnStatus eq 'RECEIVED'}"><div class="return-request-note"><strong>Return received by pharmacy</strong><p><c:out value="${o.returnReviewNote}"/></p></div></c:if>
          <c:if test="${o.paymentStatus eq 'SUCCESS' and (o.status eq 'CANCELLED' or o.returnStatus eq 'RECEIVED') and (empty o.refundStatus or o.refundStatus eq 'REJECTED')}"><form method="post" action="${pageContext.request.contextPath}/orders" class="return-request-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="action" value="requestRefund"><input type="hidden" name="orderId" value="${o.id}"><label>Refund reason <span class="optional">Optional · full demo refund, subject to administrator review</span><textarea name="reason" rows="2" maxlength="500" placeholder="Add a note for the administrator"></textarea></label><button class="button button-small" type="submit">Request full refund</button></form></c:if>
        </article>
      </c:forEach>
    </section>
  </c:when>
  <c:otherwise><div class="empty-state"><span>＋</span><h3>No orders yet</h3><p>Your pharmacy orders and delivery progress will appear here.</p><a class="button" href="${pageContext.request.contextPath}/medicines">Browse pharmacy</a></div></c:otherwise>
</c:choose>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
