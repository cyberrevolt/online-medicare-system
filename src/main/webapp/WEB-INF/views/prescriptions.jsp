<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Prescriptions"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<section class="page-intro"><div><div class="eyebrow"><c:choose><c:when test="${reviewMode}">PHARMACY REVIEW</c:when><c:otherwise>PATIENT RECORDS</c:otherwise></c:choose></div><h1><c:choose><c:when test="${reviewMode}">Prescription verification</c:when><c:otherwise>My prescriptions</c:otherwise></c:choose></h1><p>Prescription records issued by a healthcare professional for your consultation.</p></div><button class="button button-outline button-small print-trigger" type="button">Print this page</button></section>
<div class="prescription-list"><c:forEach var="rx" items="${prescriptions}"><article class="prescription-card"><div class="rx-title"><div><span class="eyebrow">PRESCRIPTION #<c:out value="${rx.id}"/></span><h2><c:out value="${rx.medicine}"/></h2></div><span class="pill"><c:out value="${rx.status}"/></span></div><div class="rx-grid"><div><span>Patient</span><strong><c:out value="${rx.patient}"/></strong></div><div><span>Prescribed by</span><strong><c:out value="${rx.doctor}"/></strong></div><div><span>Dosage</span><strong><c:out value="${rx.dosage}"/></strong></div><div><span>Frequency</span><strong><c:out value="${rx.frequency}"/></strong></div><div><span>Duration</span><strong><c:out value="${rx.duration}"/></strong></div><div><span>Instructions</span><strong><c:out value="${rx.instructions}"/></strong></div></div><p><strong>Clinical notes</strong><br><c:out value="${rx.notes}"/></p><c:if test="${rx.status eq 'REJECTED'}"><p class="alert alert-error">Review note: <c:out value="${rx.reason}"/></p></c:if><c:if test="${reviewMode and rx.status eq 'ISSUED'}"><form method="post" action="${pageContext.request.contextPath}/prescriptions" class="review-form"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="prescriptionId" value="${rx.id}"><label>Reason if rejecting<input name="reason" maxlength="500" placeholder="Optional verification note"></label><button class="button button-small" name="status" value="VERIFIED" type="submit">Verify</button><button class="button button-small button-danger" name="status" value="REJECTED" type="submit">Reject</button></form></c:if></article></c:forEach><c:if test="${empty prescriptions}"><div class="empty-state"><span>＋</span><h3>No prescriptions to show</h3><p>Issued prescription records will appear here.</p></div></c:if></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
