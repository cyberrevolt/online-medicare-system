<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Private appointment chat"/><jsp:include page="/WEB-INF/views/common/header.jsp"/>
<div class="breadcrumb"><c:choose><c:when test="${sessionScope.user.role eq 'DOCTOR'}"><a href="${pageContext.request.contextPath}/doctor/appointments">Doctor appointments</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/appointments">My appointments</a></c:otherwise></c:choose><span>›</span>Private appointment chat</div>
<section class="consultation-heading"><div><div class="eyebrow">ONE-TO-ONE APPOINTMENT</div><h1>Appointment #<c:out value="${appointmentId}"/></h1><p><strong><c:out value="${doctorName}"/></strong> with <strong><c:out value="${patientName}"/></strong></p></div><span class="pill"><c:out value="${appointmentStatus}"/></span></section>
<c:if test="${demoProfile}"><div class="demo-profile-notice"><strong>Fictional demo appointment</strong><p>This private chat is for testing the application only. The doctor profile is fictional; do not use it for medical care or send real health information.</p></div></c:if>
<div class="consultation-layout"><div class="consultation-main"><div class="consultation-details"><div><span>Date and time</span><strong><c:out value="${appointmentDate}"/> · <c:out value="${appointmentTime}"/></strong></div><div><span>Booked interaction</span><strong><c:out value="${consultationType}"/></strong></div><div><span>Fee <c:if test="${demoProfile}">(simulated)</c:if></span><strong>₹<c:out value="${fee}"/></strong></div></div>
  <c:if test="${appointmentStatus eq 'CONFIRMED'}"><section class="video-call-card" data-video-call data-appointment="${appointmentId}" data-endpoint="${pageContext.request.contextPath}/video-signal" data-csrf="${csrfToken}" data-user-id="${sessionScope.user.id}" data-user-role="${sessionScope.user.role}" data-patient-appointments="${pageContext.request.contextPath}/appointments">
    <div class="video-call-heading"><div><span class="eyebrow">PRIVATE VIDEO VISIT</span><h2>One-to-one video consultation</h2></div><span class="pill">Appointment only</span></div>
    <p>Start a private call with the other person on this appointment. Your browser will ask before using your camera and microphone.</p>
    <div class="video-call-state" data-video-state role="status" aria-live="polite">No video call is active.</div>
    <div class="video-call-actions"><button class="button button-small" type="button" data-video-start>Start video call</button><button class="button button-small" type="button" data-video-accept hidden>Accept incoming call</button><button class="button button-small button-danger" type="button" data-video-end hidden>End call</button><button class="button button-small button-outline" type="button" data-video-mic hidden>Mute microphone</button><button class="button button-small button-outline" type="button" data-video-camera hidden>Turn camera off</button></div>
    <div class="video-stage"><figure><video data-video-local autoplay playsinline muted></video><figcaption>You</figcaption></figure><figure><video data-video-remote autoplay playsinline></video><figcaption>Doctor / patient</figcaption></figure></div>
    <p class="fine-print">Video is sent directly between the two browsers; the app exchanges only call setup data. Camera access requires HTTPS, or localhost during local development. Network or firewall restrictions may prevent a direct connection.</p>
    <p class="video-call-error" data-video-error role="alert" aria-live="polite"></p>
  </section></c:if>
  <c:if test="${appointmentStatus eq 'COMPLETED'}"><section class="panel-card"><span class="eyebrow">CONSULTATION COMPLETE</span><h2>This appointment is closed</h2><p class="muted">Video calls are no longer available for this visit. Book a new appointment to start another consultation.</p><c:if test="${sessionScope.user.role eq 'PATIENT'}"><a class="button button-soft" href="${pageContext.request.contextPath}/doctors">Book a new appointment →</a></c:if></section></c:if>
  <section class="chat-card" data-appointment="${appointmentId}" data-endpoint="${pageContext.request.contextPath}/chat" data-csrf="${csrfToken}"><div class="chat-heading"><div><span class="eyebrow">PRIVATE PATIENT–DOCTOR ROOM</span><h2>One-to-one text chat</h2></div><span class="live-indicator">● Connected</span></div><p class="muted">Only the patient and doctor on this appointment can view or send messages. The room refreshes automatically.</p><div class="chat-messages" aria-live="polite"><div class="muted">Loading conversation…</div></div><form class="chat-form"><input name="message" maxlength="4000" required placeholder="Write a message…" aria-label="Message"><button class="button" type="submit">Send <span>↑</span></button></form><p class="fine-print chat-error" aria-live="polite"></p></section>
  <c:if test="${not empty prescription}"><section class="prescription-card"><span class="eyebrow">PRESCRIPTION #<c:out value="${prescription.id}"/></span><span class="pill pill-green"><c:out value="${prescription.status}"/></span><h2><c:out value="${prescription.medicine}"/></h2><div class="rx-grid"><div><span>Dosage</span><strong><c:out value="${prescription.dosage}"/></strong></div><div><span>Frequency</span><strong><c:out value="${prescription.frequency}"/></strong></div><div><span>Duration</span><strong><c:out value="${prescription.duration}"/></strong></div><div><span>Instructions</span><strong><c:out value="${prescription.instructions}"/></strong></div></div><p><strong>Clinical notes:</strong> <c:out value="${prescription.notes}"/></p><button class="button button-outline button-small print-trigger" type="button">Print prescription</button></section></c:if>
  <c:if test="${sessionScope.user.role eq 'DOCTOR' and appointmentStatus eq 'CONFIRMED' and empty prescription and not demoProfile}"><section class="panel-card prescription-create"><span class="eyebrow">DOCUMENT THE VISIT</span><h2>Issue a prescription</h2><p class="muted">Prescriptions are authored by the treating professional. This system does not diagnose or recommend treatment.</p><form method="post" action="${pageContext.request.contextPath}/consultation" class="form-stack"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="appointmentId" value="${appointmentId}"><label>Clinical notes<textarea name="clinicalNotes" required maxlength="2000" rows="3" placeholder="Add consultation context and notes"></textarea></label><label>Medicine name<input name="medicine" required maxlength="180"></label><div class="form-row"><label>Dosage<input name="dosage" required maxlength="100" placeholder="e.g. as directed"></label><label>Frequency<input name="frequency" required maxlength="100"></label></div><div class="form-row"><label>Duration<input name="duration" required maxlength="100"></label><label>Instructions<input name="instructions" maxlength="500"></label></div><button class="button" type="submit">Issue prescription <span>→</span></button></form></section></c:if>
</div><aside class="consultation-aside"><div class="aside-card"><span class="icon-tile lavender">♡</span><h3>People in this visit</h3><div class="person-line"><div class="doctor-avatar">DR</div><div><strong><c:out value="${doctorName}"/></strong><span>Doctor</span></div></div><div class="person-line"><div class="doctor-avatar patient-avatar">PT</div><div><strong><c:out value="${patientName}"/></strong><span>Patient</span></div></div></div><div class="care-disclaimer"><strong>Medical care notice</strong><p>Online Medic is a communication and management platform. Medical decisions and prescriptions come from qualified healthcare professionals. Demo profiles are fictional.</p></div><c:if test="${sessionScope.user.role eq 'PATIENT'}"><a class="button button-full button-soft" href="${pageContext.request.contextPath}/prescriptions">My prescriptions</a></c:if></aside></div>
<jsp:include page="/WEB-INF/views/common/footer.jsp"/>
