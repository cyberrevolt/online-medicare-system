# Optional PostgreSQL connection. Without DATABASE_URL, local H2 is used for development.
DATABASE_URL=jdbc:postgresql://localhost:5432/online_medic
DATABASE_USER=online_medic
DATABASE_PASSWORD=change-me
# Optional H2 local database path when DATABASE_URL is not set.
H2_DATABASE_URL=jdbc:h2:./data/online_medic;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
# For PostgreSQL bootstrap only. Remove after the first successful startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
